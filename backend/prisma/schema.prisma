generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model historialmovimiento {
  id         Int      @id @default(autoincrement())
  productoId Int
  cantidad   Int
  tipo       String
  motivo     String   @db.VarChar(255)
  creadoEn   DateTime @default(now())
  producto   producto @relation(fields: [productoId], references: [id], onDelete: Cascade, map: "HistorialMovimiento_productoId_fkey")

  @@index([productoId], map: "HistorialMovimiento_productoId_fkey")
}

model producto {
  id                  Int                   @id @default(autoincrement())
  nombre              String                @db.VarChar(100)
  stock               Int                   @default(0)
  precio              Float
  creadoEn            DateTime              @default(now())
  historialmovimiento historialmovimiento[]
}

model usuario {
  id       Int      @id @default(autoincrement())
  email    String   @unique(map: "Usuario_email_key") @db.VarChar(150)
  password String   @db.VarChar(255)
  rol      String   @default("Empleado")
  creadoEn DateTime @default(now())
}
